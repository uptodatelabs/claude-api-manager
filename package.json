{
  "name": "claude-api-manager",
  "version": "2.1.1",
  "description": "TUI dashboard for managing Claude Code API configurations. Save multiple API profiles and switch providers with a keystroke.",
  "main": "src/manager.cjs",
  "bin": {
    "cam": "bin/cli.mjs"
  },
  "files": [
    "bin",
    "src"
  ],
  "scripts": {
    "start": "node bin/cli.mjs",
    "prepublishOnly": "node -e \"import('./src/tui/App.mjs').then(() => console.log('OK'))\""
  },
  "keywords": [
    "claude",
    "claude-code",
    "api",
    "settings",
    "manager",
    "profile",
    "tui",
    "terminal",
    "ink",
    "anthropic"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uptodatelabs/claude-api-manager.git"
  },
  "homepage": "https://github.com/uptodatelabs/claude-api-manager",
  "bugs": {
    "url": "https://github.com/uptodatelabs/claude-api-manager/issues"
  },
  "dependencies": {
    "chalk": "^4.1.2",
    "commander": "^11.1.0",
    "fastify": "^5.11.3",
    "ink": "^5.0.1",
    "ink-select-input": "^6.0.0",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "react": "^18.2.0"
  }
